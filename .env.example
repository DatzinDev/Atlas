# Development environment for the local PostGIS container.
# Copy to .env and adjust if the defaults collide with something already running.
#   cp .env.example .env

POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
POSTGRES_DB=atlas
POSTGRES_PORT=5433

# Connection string used by the test suite.
ATLAS_TEST_DATABASE_URL=postgresql://atlas:atlas@localhost:5433/atlas
